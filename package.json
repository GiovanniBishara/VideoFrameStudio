{
  "name": "videoframe-transcript-studio",
  "version": "1.2.0",
  "private": true,
  "description": "Frame extraction, Whisper transcription and video compression for long lecture recordings, entirely in the browser (WebCodecs, WebGPU, Web Workers).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:single": "node build.mjs --single",
    "build:test": "node build.mjs --test",
    "dev": "node build.mjs --serve",
    "typecheck": "tsc -p tsconfig.json",
    "test": "esbuild tests/unit.test.ts --bundle --platform=node --format=esm --outfile=.test/unit.mjs --log-level=warning && node .test/unit.mjs"
  },
  "dependencies": {
    "mediabunny": "1.65.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GiovanniBishara/VideoFrameStudio.git"
  }
}
